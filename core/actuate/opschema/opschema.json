{
  "op_classes": [
    {
      "op_class": "restart-service",
      "op": "restart",
      "family": "service-lifecycle",
      "safety_tier": "low-reversible",
      "params": [
        {
          "name": "unit",
          "type": "string",
          "required": true,
          "example": "nginx",
          "description": "the systemd unit to restart"
        }
      ],
      "argv_template": [
        "systemctl",
        "restart",
        "${unit}"
      ],
      "rollback_template": [
        "systemctl",
        "restart",
        "${unit}"
      ],
      "commit_confirmed": {
        "window_seconds": 600
      }
    },
    {
      "op_class": "restart-container",
      "op": "restart",
      "family": "container-lifecycle",
      "safety_tier": "low-reversible",
      "params": [
        {
          "name": "container",
          "type": "string",
          "required": true,
          "example": "librespeed",
          "description": "the docker container to restart"
        }
      ],
      "argv_template": [
        "docker",
        "restart",
        "${container}"
      ]
    },
    {
      "op_class": "start-container",
      "op": "start",
      "family": "container-lifecycle",
      "safety_tier": "low-reversible",
      "params": [
        {
          "name": "container",
          "type": "string",
          "required": true,
          "example": "mealie",
          "description": "the docker container to start (it is STOPPED; use restart-container for one that is running but wedged)"
        }
      ],
      "argv_template": [
        "docker",
        "start",
        "${container}"
      ],
      "rollback_template": [
        "docker",
        "stop",
        "${container}"
      ]
    },
    {
      "op_class": "reload-service",
      "op": "reload",
      "family": "service-lifecycle",
      "safety_tier": "low-reversible",
      "params": [
        {
          "name": "unit",
          "type": "string",
          "required": true,
          "example": "nginx",
          "description": "the systemd unit to reload (re-read config, non-disruptive)"
        }
      ],
      "argv_template": [
        "systemctl",
        "reload",
        "${unit}"
      ],
      "rollback_template": [
        "systemctl",
        "reload",
        "${unit}"
      ],
      "commit_confirmed": {
        "window_seconds": 600
      }
    },
    {
      "op_class": "start-service",
      "op": "start",
      "family": "service-lifecycle",
      "safety_tier": "low-reversible",
      "params": [
        {
          "name": "unit",
          "type": "string",
          "required": true,
          "example": "nginx",
          "description": "the systemd unit to START (bring a down service back up)"
        }
      ],
      "argv_template": [
        "systemctl",
        "start",
        "${unit}"
      ],
      "rollback_template": [
        "systemctl",
        "stop",
        "${unit}"
      ]
    },
    {
      "op_class": "disk-grow",
      "op": "grow",
      "family": "resource-resize",
      "safety_tier": "medium",
      "effect_kind": "awx-launch",
      "params": [
        {
          "name": "filesystem",
          "type": "string",
          "required": true,
          "example": "/var",
          "description": "the mount point / logical volume to GROW (never shrink, never delete) — the disk-full remediation"
        },
        {
          "name": "grow_by",
          "type": "string",
          "required": true,
          "example": "10G",
          "description": "how much to grow by (an increment the AWX play's guards bound), e.g. 10G"
        }
      ]
    },
    {
      "op_class": "start-guest",
      "op": "start",
      "family": "guest-lifecycle",
      "safety_tier": "low-reversible",
      "effect_kind": "proxmox-lifecycle",
      "requires_target_state": "not-running",
      "commit_confirmed": {
        "window_seconds": 600
      },
      "rollback_op_class": "stop-guest",
      "params": [
        {
          "name": "guest",
          "type": "string",
          "required": true,
          "example": "librespeed01",
          "description": "the Proxmox VE guest (VM/LXC) to START — bring a DOWN guest that should be up back up (reversible; stop is its inverse)"
        }
      ]
    },
    {
      "op_class": "stop-guest",
      "op": "stop",
      "family": "guest-lifecycle",
      "safety_tier": "low-reversible",
      "effect_kind": "proxmox-lifecycle",
      "requires_target_state": "running",
      "params": [
        {
          "name": "guest",
          "type": "string",
          "required": true,
          "example": "librespeed01",
          "description": "the Proxmox VE guest (VM/LXC) to STOP. Exists as start-guest's declared commit-confirmed inverse (spec/029 sign-off: v1 classes include start-guest, inverse stop) — the armed revert's compensating action when a started guest fails its confirm window. Not fault-provoked on its own: no estate fault is healed by stopping a guest (see spec/opcover-exemptions.json)."
        }
      ]
    },
    {
      "op_class": "k8s-set-replicas",
      "op": "set replicas",
      "family": "k8s-workload",
      "safety_tier": "medium",
      "effect_kind": "k8s-declarative",
      "params": [
        {
          "name": "replicas",
          "type": "string",
          "required": true,
          "example": "3",
          "description": "the desired replica count (a non-negative integer) for a GitOps-MANAGED k8s workload whose replica field lives in a declarative source (a Terraform variable or a Helm value). Use ONLY for a workload-capacity condition on a managed target — NOT for a host / service / guest / disk fault, each of which has its own op-class. The change is proposed as a MERGE REQUEST that edits that one field; it is NEVER applied to the cluster directly — a human merges the MR and Atlantis/Argo reconciles. An HPA-owned replica field is refused (spec/017, TG-122 slice 3)."
        }
      ]
    }
  ]
}
