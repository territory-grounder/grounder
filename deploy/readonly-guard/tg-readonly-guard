#!/bin/sh
# tg-readonly-guard — a forced command pinned to TG's host-DIAGNOSTICS key in authorized_keys on every
# host TG reads (TG-280, split from TG-153 Critical#1).
#
# WHY. Until this existed, TG read every estate host as ROOT using /secrets/one_key — the unrestricted
# estate root key, mode 0640 root:65532, mounted readable into a worker that ALSO processes untrusted
# alert, syslog and host content. That is the HuggingFace worker->node->lateral chain with the pivot
# pre-installed: one /secrets read hands an attacker a stock SSH client running as root on the whole
# fleet, with every TG application-layer gate bypassed because those gates only bind commands TG itself
# constructs. The same key is AWX's estate credential, so its blast radius was never "the hosts TG
# reads" — it was everything.
#
# This guard reduces a leaked diagnostic key to EXACTLY TG's read-only grammar: twelve fixed diagnostic
# commands and, where the operator enables it, a bounded tail of named log files. No shell, no arbitrary
# command, no write, no forwarding.
#
# CONTRACT. TG single-quotes every argv element (syslogng.RemoteCommand), so SSH_ORIGINAL_COMMAND is e.g.
#   'systemctl' '--failed' '--no-legend' '--no-pager'
# We match the FULL string byte-for-byte against an operator-owned allowlist generated by
# tools/readallow. A match is provably one of those vetted lines, so exec-ing it is safe. Everything else
# is denied WITHOUT evaluation.
#
# WHY EXACT MATCHING AND NOT A PATTERN. A pattern-matching guard is a parser, and a parser operating on
# attacker-controlled input inside the security boundary is the thing being defended against. Variable
# arguments are handled by enumerating the permitted values at generation time instead.
#
# EXIT 42 is the shared "guard refused" signal, same as tg-actuator-guard, so the caller can tell a
# refusal from an unreachable host. That distinction is load-bearing: this lane reports a failed read as
# "(<host> was unreachable or the read errored)", and TG-271 is the record of what happens when the
# agent cannot tell blind from quiet.
set -eu
CMD="${SSH_ORIGINAL_COMMAND:-}"
ALLOW="${TG_READONLY_ALLOWFILE:-/etc/tg-readonly-guard.allow}"

log() { logger -t tg-readonly-guard -- "$1" 2>/dev/null || true; }
deny() {
  log "DENY: ${CMD:-<interactive-shell>}"
  echo "tg-readonly-guard: refused — not in the TG read-only allowlist" >&2
  exit 42
}

# No interactive session, and the allowlist must exist and be readable. FAIL CLOSED: a missing allowlist
# denies everything rather than defaulting to permissive, because the failure that matters here is the
# one where the file did not deploy.
[ -n "$CMD" ] || deny
[ -r "$ALLOW" ] || deny

# Whole-line, fixed-string match. No word-splitting, globbing or command substitution touches the
# untrusted CMD before this gate. Comment lines in the allowlist start with '#', and CMD always begins
# with a single quote, so a comment can never match.
if grep -qxF -- "$CMD" "$ALLOW"; then
  log "ALLOW: $CMD"
  eval "exec $CMD"
fi
deny
